# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repositorio.

# URL pública de la app (para redirecciones del setup link y URLs de webhooks)
APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kapso (app.kapso.ai > Settings > API keys)
KAPSO_API_KEY=
KAPSO_API_BASE_URL=https://api.kapso.ai
# Secreto con el que Kapso firma los webhooks. Debe coincidir con el secret_key registrado.
KAPSO_WEBHOOK_SECRET=
# Secreto del webhook de PROYECTO (Integrations > Webhooks > Platform webhooks), para whatsapp.phone_number.created
KAPSO_PROJECT_WEBHOOK_SECRET=
# Versión de Graph que Kapso expone en su proxy de Meta
KAPSO_META_GRAPH_VERSION=v24.0

# Calificador de plantillas
# Proveedor de análisis (frases y reescritura): deepseek
TEMPLATE_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Opcional: si existe, Jev (TypeSafe) da las probabilidades calibradas de categoría
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# Protege los endpoints de cron (Authorization: Bearer ...)
CRON_SECRET=

# Alertas por correo (Resend). Opcional: sin clave, las alertas quedan solo en el panel.
RESEND_API_KEY=
ALERTS_FROM_EMAIL=alertas@tudominio.com
# Alertas por WhatsApp desde el número de la plataforma (opcional). Plantilla de utilidad con {{1}} título y {{2}} detalle.
ALERTS_PHONE_NUMBER_ID=
ALERTS_TEMPLATE_NAME=
ALERTS_TEMPLATE_LANGUAGE=es
